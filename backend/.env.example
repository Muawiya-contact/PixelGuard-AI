# Gemini API key — developer key (AIza…) or paid/service-restricted key (AQ.…).
# Either variable name works; get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# PAID_GEMINI_API_KEY=your_paid_key_here

# Optional: model override. Default is gemini-pro-latest (auto-falls back to
# gemini-flash-latest and other current models if unavailable).
# GEMINI_MODEL=gemini-flash-latest

# Optional: set to "vertex" ONLY for true Vertex AI express-mode keys.
# GEMINI_KEY_MODE=developer

# Production CORS: comma-separated frontend origins (localhost:5173 is always allowed).
# Any *.vercel.app origin — production and preview deploys — is allowed by default,
# so this is usually only needed for non-Vercel frontends.
# CORS_ORIGINS=https://your-frontend.netlify.app
#
# Override the Vercel-matching pattern (re.fullmatch against the Origin header):
# CORS_ORIGIN_REGEX=https://pixelguard-ai[a-z0-9-]*\.vercel\.app
#
# Escape hatch — allow every origin (demos/hackathon evaluation):
# CORS_ORIGINS=*
